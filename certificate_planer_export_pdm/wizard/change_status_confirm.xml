<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_change_status_confirm" model="ir.ui.view">
        <field name="name">change.status.confirm</field>
        <field name="model">certificate_planer.change_status_confirm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p>
                        <field readonly="1" name="change_status_confirm_text" />
                    </p>
                </sheet>
                <footer>
                    <button
                        name="action_confirm_status"
                        type="object"
                        string="Yes"
                        class="oe_highlight"
                    />
                    <button string="No" special="cancel" />
                </footer>
            </form>
        </field>
</record>

<record id="action_change_status_confirm" model="ir.actions.act_window">
    <field name="name">Confirm status</field>
    <field name="res_model">certificate_planer.change_status_confirm</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

</odoo>
