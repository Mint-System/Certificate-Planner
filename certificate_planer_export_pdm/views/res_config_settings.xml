<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">certificate_planer_export_pdm.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Certificate Planner Export PDM" string="Certificate Planner Export PDM" data-key="certificate_planer_export_pdm">
                    
                    <h2>Certificate Planner Export PDM</h2>
                    <div class="row mt16 o_settings_container" id="certificate_planer_export_pdm_setting_container">
                        <div class="col-12 col-lg-12 o_setting_box" id="certificate_planer_export_pdm_text_block">
                            
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Text Block for Change Status Dialog.
                                </div>
                                <div class="content-group">

                                    <div class="row mt16">
                                        <label class="col-lg-3 o_light_label" string="Status Dialog Change Text" for="change_status_text"/>                                        
                                        <field name="change_status_text" class="oe_inline" style="width: 70% !important;"/>
                                    </div>

                                </div>
                            </div>

                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Text Block for Change Status Confirm Dialog.
                                </div>
                                <div class="content-group">

                                    <div class="row mt16">
                                        <label class="col-lg-3 o_light_label" string="Status Dialog Change Confirm Text" for="change_status_confirm_text"/>                                        
                                        <field name="change_status_confirm_text" class="oe_inline" style="width: 70% !important;"/>
                                    </div>

                                </div>
                            </div>

                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    PDM Export type.
                                </div>
                                <div class="content-group">

                                    <div class="row mt16">
                                        <label class="col-lg-3 o_light_label" string="PDM Export type" for="pdm_export_type"/>                                        
                                        <field name="pdm_export_type" class="oe_inline" style="width: 70% !important;"/>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                    
                </div>
            </xpath>
        </field>
    </record>

</odoo>
