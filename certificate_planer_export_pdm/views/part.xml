<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_part_form_export_button" model="ir.ui.view">
        <field name="name">certificate_planer.part.form.xml.export.button</field>
        <field name="model">certificate_planer.part</field>
        <field name="inherit_id" ref="certificate_planer.part_form"/>
        <field name="arch" type="xml">

            <!-- Insert into the header -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_export_xml"
                        type="object"
                        string="Export XML"
                        class="oe_stat_button" 
                        icon="fa-arrow-right" />
            </xpath>

        </field>
    </record>

</odoo>
