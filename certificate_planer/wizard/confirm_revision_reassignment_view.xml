<odoo>
    <record id="view_confirm_revision_reassignment" model="ir.ui.view">
        <field name="name">certificate_planer.confirm.revision.reassignment.form</field>
        <field name="model">certificate_planer.confirm.revision.reassignment</field>
        <field name="arch" type="xml">
            <form string="Reassign Revision?">
                <group>
                    <p>This revision already belongs to another change.
                                   Do you want to reassign it?"
                    </p>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
